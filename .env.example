# Copy to .env and fill in values. Never commit .env to git.

FIRECRAWL_API_KEY=
GEMINI_API_KEY=
SLACK_WEBHOOK_URL=

# Slack OAuth (web UI "Add to Slack" — Step 6)
# Create app at https://api.slack.com/apps → OAuth & Permissions
# Redirect URL: http://127.0.0.1:8000/slack/callback (or your OUTPOST_BASE_URL + /slack/callback)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# OUTPOST_BASE_URL=http://127.0.0.1:8000
# SLACK_REDIRECT_URI=http://127.0.0.1:8000/slack/callback

# Optional
OUTPOST_THREAT_THRESHOLD=7
# OUTPOST_PROFILE_PATH=profile.yaml

# Supabase (use service_role only in server/CI — never in a browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
# Anon key — web UI auth only (server-side sign-in; never expose service_role to browser)
SUPABASE_ANON_KEY=

# Web UI session signing (generate: python -c "import secrets; print(secrets.token_hex(32))")
OUTPOST_SESSION_SECRET=
